# Example environment file for Docker Compose deployment of hertz-track API
# Copy this file to `.env` under the same directory and adjust values as needed.

# Port exposed on the host, e.g. 8080
APP_PORT=8080

# Mongo connection URI used by the API container
# For local docker-compose, the hostname is the `mongo` service name
MONGO_URI=mongodb://mongo:27017/trackapp

# MySQL DSN (if set, the server will use MySQL persistence and ignore MONGO_URI)
# Example (Aliyun RDS): user:pass@tcp(rm-xxxx.mysql.rds.aliyuncs.com:3306)/track?parseTime=true&loc=Local&charset=utf8mb4
MYSQL_DSN=

# Bind/listen address used inside the container
# Prefer SERVER_ADDR; BIND_ADDR is kept for backward compatibility.
SERVER_ADDR=:8080
BIND_ADDR=:8080

# Container timezone. Scheduler cron specs are evaluated in the process timezone.
TZ=Asia/Shanghai

# AMap keys (optional)
# AMAP_KEY is a legacy alias for AMAP_WEB_KEY.
AMAP_WEB_KEY=YOUR_AMAP_WEB_KEY_PLACEHOLDER
AMAP_REST_KEY=YOUR_AMAP_REST_KEY_PLACEHOLDER
AMAP_KEY=YOUR_AMAP_KEY_PLACEHOLDER

# WeChat configuration (placeholders, do not put real secrets here)
WECHAT_APP_ID=YOUR_WECHAT_APP_ID_PLACEHOLDER
WECHAT_APP_SECRET=YOUR_WECHAT_APP_SECRET_PLACEHOLDER

# Default locale and client version metadata for logging/monitoring
APP_LOCALE=zh-CN
APP_CLIENT_VERSION=1.0.0

# Container log directory. docker-compose mounts the same path from the host.
LOG_DIR=/var/log/track_server

# Scheduler and analytics collection.
# SCHEDULER_ENABLED=true enables background jobs, including analytics_sync.
SCHEDULER_ENABLED=false
ANALYTICS_ENABLED=true
ANALYTICS_LOCAL_DIR=
ANALYTICS_SYNC_CRON=0 3 * * *
ANALYTICS_OSS_PREFIX=analytics/ods/
ANALYTICS_MAX_BATCH_SIZE=50
ANALYTICS_MAX_BODY_BYTES=262144

# Required for server-side OSS download and analytics ODS sync.
# Use the bucket region's internal endpoint to avoid public traffic fees.
OSS_INTERNAL_ENDPOINT=

# JWT secret used for signing tokens (change in production)
JWT_SECRET=CHANGE_ME_IN_PROD

# TLS configuration (optional)
# When both TLS_CERT_FILE and TLS_KEY_FILE are set, the server starts in HTTPS mode.
# Leave them empty to keep using plain HTTP.
#
# Steps to enable TLS with Docker Compose:
#   1. Place your cert and key files in deploy/certs/ (e.g. server.crt, server.key)
#   2. Uncomment the volumes and TLS port lines in docker-compose.yml
#   3. Set BIND_ADDR to :8443 and fill in the paths below (container paths)
#   4. Run: docker compose up -d
#
# Example:
#   BIND_ADDR=:8443
#   TLS_CERT_FILE=/app/certs/server.crt
#   TLS_KEY_FILE=/app/certs/server.key
TLS_CERT_FILE=
TLS_KEY_FILE=
