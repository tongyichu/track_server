# Copy these keys into the production environment file after preparing a verified
# sender in Alibaba Cloud DirectMail or another SMTP provider. No real secrets here.
# DirectMail uses a dedicated SMTP password, not the OSS access key or console password.
ADMIN_SMTP_HOST=smtpdm.aliyun.com
ADMIN_SMTP_PORT=465
ADMIN_SMTP_TLS_MODE=tls
ADMIN_SMTP_FROM=no-reply@notify.example.com
ADMIN_SMTP_USERNAME=no-reply@notify.example.com
ADMIN_SMTP_PASSWORD=
# TLS modes: tls = implicit TLS (normally 465); starttls = mandatory STARTTLS.
# There is no plaintext SMTP or local sendmail fallback.
